# 云服务器部署配置模板 — 复制为 .env.production 并填写真实值
# （.env.production 已被 gitignore，密钥不会进仓库）

# ── LLM（DeepSeek OpenAI 兼容；按需修改模型名）──
OPENAI_API_KEY=sk-在这里填你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── GitHub OAuth（对外访问必须配置；回调填你的前端 Pages 域名）──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://math-model-agent.pages.dev/auth/callback

# ── JWT（换成足够长的随机字符串，例如 openssl rand -hex 32 的输出）──
JWT_SECRET=replace-with-random-secret

# ── 沙箱（云上固定 subprocess，容器内无 docker）──
SANDBOX_BACKEND=subprocess
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_TIMEOUT=60
