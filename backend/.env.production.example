# ============================================
# MathModelAgent 云服务器生产配置模板
# 复制为 .env.production 并填入真实 Key（该文件已被 gitignore）
# ============================================

# ---- LLM API Keys ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- 知识库 Embedding（可选；不填则知识库向量检索禁用）----
KB_EMBEDDING_PROVIDER=openai_compatible
KB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
KB_EMBEDDING_API_KEY=
KB_VISION_MODEL=

# ---- Model Selection ----
CLASSIFIER_MODEL=deepseek-chat
PLANNER_MODEL=deepseek-chat
ANALYSIS_MODEL=deepseek-chat
MODELING_MODEL=deepseek-chat
SOLVING_MODEL=deepseek-chat
VERIFICATION_MODEL=deepseek-chat
WRITING_MODEL=deepseek-chat
CHAT_MODEL=deepseek-chat

# ---- Model Parameters ----
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=8192

# ---- Redis（不可用时自动回退 fakeredis 内存模式，无需部署 Redis）----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=./data/chroma_db

# ---- Knowledge Base ----
KB_ROOT_DIR=./knowledge_base

# ---- Sandbox（云容器内无 Docker，回退 subprocess）----
SANDBOX_TIMEOUT=60
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_BACKEND=subprocess

# ---- Server ----
HOST=0.0.0.0
PORT=8002
DEBUG=false

# ---- GitHub OAuth ----
# 在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL: https://nb.sgweb.asia
#   Authorization callback URL: https://nb.sgweb.asia/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://nb.sgweb.asia/auth/callback

# ---- JWT（必填：随机字符串）----
JWT_SECRET=change-me-to-a-random-string