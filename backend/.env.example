# ============================================
# MathModelAgent 环境变量配置
# 复制此文件为 .env 并填入你的真实 Key
# ============================================

# ---- LLM API Keys ----
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API Key（可选，使用 GPT 模型时需要）
OPENAI_API_KEY=sk-xxx

# Anthropic API Key（可选，使用 Claude 模型时需要）
ANTHROPIC_API_KEY=sk-ant-xxx

# ---- 知识库 Embedding（可选，用于向量检索）----
# 推荐：在前端 /apikeys 页添加「向量」用途的 Key（无需改此文件）。
# 此处为备选的全局配置；provider 可选 openai_compatible（默认）/ huggingface / openai
KB_EMBEDDING_PROVIDER=openai_compatible
KB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
KB_EMBEDDING_API_KEY=

# 知识库导入提取用视觉模型(可选)。不填: 图片/扫描PDF降级为纯文本(OCR);
# 填写支持视觉的模型名(如 qwen-vl-plus、gpt-4o)后启用图片识别。
# 该模型使用上方 OPENAI_API_KEY / ANTHROPIC_API_KEY,不受 /apikeys 活动 Key 覆盖。
KB_VISION_MODEL=

# ---- Model Selection (每个 Agent 使用的模型) ----
CLASSIFIER_MODEL=deepseek-v4-flash
PLANNER_MODEL=deepseek-v4-flash
ANALYSIS_MODEL=deepseek-v4-flash
MODELING_MODEL=deepseek-v4-flash
SOLVING_MODEL=deepseek-v4-flash
VERIFICATION_MODEL=deepseek-v4-flash
WRITING_MODEL=deepseek-v4-flash

# ---- Model Parameters ----
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=8192

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
# 本地模式（默认）：向量索引存储在本地文件
CHROMA_PERSIST_DIR=./data/chroma_db
# 独立容器模式（可选）：连接 Docker chromadb 容器，主进程省 300-500MB
# 用法: docker compose up -d chromadb  然后设置此 URL
# CHROMA_HTTP_URL=http://localhost:8001

# ---- Knowledge Base ----
KB_ROOT_DIR=./knowledge_base

# ---- Sandbox ----
SANDBOX_TIMEOUT=60
SANDBOX_MAX_MEMORY_MB=512
# 执行后端: subprocess（默认，轻量但 Windows 下无内存限制）| docker（硬隔离，推荐生产用）
SANDBOX_BACKEND=subprocess

# ---- Server ----
HOST=0.0.0.0
PORT=8002
DEBUG=true

# ---- GitHub OAuth ----
# 在 https://github.com/settings/developers 创建 OAuth App
# Homepage URL: http://localhost:5174
# Authorization callback URL: http://localhost:8002/api/auth/callback
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_REDIRECT_URI=http://localhost:5174/auth/callback

# ---- JWT ----
# 随机字符串，用于签名登录 Token
JWT_SECRET=change-me-to-a-random-string
